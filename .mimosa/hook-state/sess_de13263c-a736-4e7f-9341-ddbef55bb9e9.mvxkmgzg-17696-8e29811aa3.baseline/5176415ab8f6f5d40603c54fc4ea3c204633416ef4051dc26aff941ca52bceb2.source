// QA 截图脚本：node shot.js <round> [mode]
// mode: sweep(默认，全套) | top | full | mobile | interact
const puppeteer = require('puppeteer-core');
const fs = require('fs');
const path = require('path');

const EDGE = 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe';
const URL = 'http://127.0.0.1:8321/';
const OUT = path.join(__dirname, 'shots');

const round = process.argv[2] || '00';
const mode = process.argv[3] || 'sweep';

const consoleLogs = [];
async function newPage(browser, { w = 1600, h = 900, mobile = false, skipBoot = true } = {}) {
  const page = await browser.newPage();
  await page.setViewport({ width: w, height: h, deviceScaleFactor: 1, isMobile: mobile, hasTouch: mobile });
  page.on('console', m => consoleLogs.push(`[${m.type()}] ${m.text()}`));
  page.on('pageerror', e => consoleLogs.push(`[PAGEERROR] ${e.message}`));
  page.on('requestfailed', r => consoleLogs.push(`[REQFAIL] ${r.url()} ${r.failure() && r.failure().errorText}`));
  await page.goto(URL, { waitUntil: 'networkidle0', timeout: 20000 });
  if (skipBoot) {
    await page.evaluate(() => sessionStorage.setItem('p3_booted', '1'));
    await page.goto(URL, { waitUntil: 'networkidle0', timeout: 20000 });
  } else {
    await page.evaluate(() => sessionStorage.removeItem('p3_booted'));
    await page.goto(URL, { waitUntil: 'networkidle0', timeout: 20000 });
  }
  await new Promise(r => setTimeout(r, 900));
  return page;
}

(async () => {
  const browser = await require('./browser')(puppeteer);
  try {
    if (mode === 'sweep' || mode === 'top' || mode === 'full') {
      const page = await newPage(browser, { w: 1600, h: 900 });
      if (mode === 'sweep' || mode === 'top') {
        await page.screenshot({ path: path.join(OUT, `r${round}-desktop-top.png`) });
      }
      if (mode === 'sweep' || mode === 'full') {
        // 全页截图前把 reveal 全部触发
        await page.evaluate(async () => {
          document.querySelectorAll('.reveal').forEach(el => el.classList.add('in'));
          window.scrollTo(0, document.body.scrollHeight);
          await new Promise(r => setTimeout(r, 600));
          window.scrollTo(0, 0);
          await new Promise(r => setTimeout(r, 400));
        });
        await new Promise(r => setTimeout(r, 500));
        await page.screenshot({ path: path.join(OUT, `r${round}-desktop-full.png`), fullPage: true });
      }
      await page.close();
    }
    if (mode === 'sweep' || mode === 'mobile') {
      const m = await newPage(browser, { w: 390, h: 844, mobile: true });
      await m.evaluate(async () => {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('in'));
        window.scrollTo(0, document.body.scrollHeight);
        await new Promise(r => setTimeout(r, 500));
        window.scrollTo(0, 0);
        await new Promise(r => setTimeout(r, 300));
      });
      await m.screenshot({ path: path.join(OUT, `r${round}-mobile-full.png`), fullPage: true });
      await m.close();
    }
    if (mode === 'boot') {
      const b = await newPage(browser, { w: 1600, h: 900, skipBoot: false });
      await new Promise(r => setTimeout(r, 1400));
      await b.screenshot({ path: path.join(OUT, `r${round}-boot.png`) });
      await b.close();
    }
  } finally {
    try { await browser.close(); } catch (e) { /* noop */ }
  }
  fs.writeFileSync(path.join(OUT, `r${round}-console.json`), JSON.stringify(consoleLogs, null, 2));
  console.log('DONE round', round, 'mode', mode);
  console.log('CONSOLE:', consoleLogs.length ? consoleLogs.join('\n') : '(clean)');
})().catch(e => { console.error('FATAL', e.message); process.exit(1); });
