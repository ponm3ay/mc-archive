// 零上下文盲审：不读取任何源码/设计意图，只度量线上渲染结果
// node audit.js <url> <label>
const puppeteer = require('puppeteer-core');
const label = process.argv[3] || 'live';
(async () => {
  const b = await require('./browser')(puppeteer);
  const findings = [];
  const F = (sev, cat, msg) => findings.push(`[${sev}] ${cat}: ${msg}`);

  async function audit(viewport, tag) {
    const p = await b.newPage();
    await p.setViewport(viewport);
    const isMobile = tag === 'mobile';
    const cdp = await p.createCDPSession();
    await cdp.send('Network.setCacheDisabled', { cacheDisabled: true });
    await p.goto(process.argv[2], { waitUntil: 'networkidle0', timeout: 60000 });
    await p.evaluate(() => { sessionStorage.setItem('p3_booted', '1'); document.querySelectorAll('.reveal').forEach(el => el.classList.add('in')); });
    await p.reload({ waitUntil: 'networkidle0', timeout: 60000 });
    await new Promise(r => setTimeout(r, 1200));
    const R = await p.evaluate((isMobile) => {
      const out = { misalign: [], overlap: [], contrast: [], tap: [], fonts: {}, headings: [], a11y: [], imgs: [], smalltext: [] };
      const vw = document.documentElement.clientWidth;
      const containerL = (document.querySelector('.container') || document.body).getBoundingClientRect().left;
      const els = [...document.querySelectorAll('main *, .footer *')].filter(el => {
        if (el.closest('svg') || el.namespaceURI.includes('svg')) return false;   // SVG 插图内部不计
        if (el.getAttribute && el.getAttribute('aria-hidden') === 'true') return false; // 装饰元素不计
        const r = el.getBoundingClientRect(); const cs = getComputedStyle(el);
        return r.width > 8 && r.height > 8 && cs.visibility !== 'hidden' && cs.opacity !== '0';
      });
      // 1) 对齐：面板/卡片/标题左缘与容器左缘偏差（面板内部元素按设计有内边距，跳过）
      els.forEach(el => {
        if (!/^(ARTICLE|SECTION|HEADER|UL|H[1-3]|P)$/.test(el.tagName)) return;
        if (el.closest('.panel, .op-card, .status-card, .avatar-panel, .connect-card, .admin-box, .ops-index-panel, .modules-panel')) return;
        const r = el.getBoundingClientRect();
        if (el.closest('.ops-viewport, .ticker, .hero-quick, .status-grid, .modules-grid')) return;
        const dev = Math.abs(r.left - containerL);
        if (dev > 2 && dev < 40 && r.left > containerL) out.misalign.push(`${el.tagName}.${String(el.className).split(' ')[0]} 左缘偏 ${dev.toFixed(0)}px`);
      });
      // 2) 重叠：非父子可见元素矩形相交（排除 pointer-events:none 的装饰层）
      const rects = els.map(el => ({ el, r: el.getBoundingClientRect() }))
        .filter(x => getComputedStyle(x.el).pointerEvents !== 'none' && x.r.width > 30 && x.r.height > 14);
      for (let i = 0; i < rects.length; i++) for (let j = i + 1; j < rects.length; j++) {
        const a = rects[i], c = rects[j];
        if (a.el.contains(c.el) || c.el.contains(a.el)) continue;
        if (a.el.closest('.portrait-frame') && c.el.closest('.portrait-frame')) continue; // 肖像容器内的覆盖式控件
        if (a.el.closest('.op-card') && c.el.closest('.op-card') &&
            ((a.el.closest('.op-veil') && !c.el.closest('.op-veil')) || (c.el.closest('.op-veil') && !a.el.closest('.op-veil')))) continue; // 作战卡覆盖揭示层 by-design
        const ox = Math.min(a.r.right, c.r.right) - Math.max(a.r.left, c.r.left);
        const oy = Math.min(a.r.bottom, c.r.bottom) - Math.max(a.r.top, c.r.top);
        if (ox > 8 && oy > 8) {
          const cls = el => el.tagName + '.' + String(el.className).split(' ')[0];
          out.overlap.push(`${cls(a.el)} × ${cls(c.el)} 重叠 ${Math.round(ox)}x${Math.round(oy)}`);
          if (out.overlap.length > 6) break;
        }
      }
      // 3) 对比度（文本 vs 最近祖先背景）
      function lum(r, g, bl) { const f = v => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }; return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(bl); }
      function parse(s) { const m = s.match(/rgba?\(([\d.]+),\s*([\d.]+),\s*([\d.]+)(?:,\s*([\d.]+))?\)/); return m ? [+m[1], +m[2], +m[3], m[4] === undefined ? 1 : +m[4]] : null; }
      els.forEach(el => {
        const cs = getComputedStyle(el);
        const own = [...el.childNodes].some(n => n.nodeType === 3 && n.textContent.trim());
        if (!own || +cs.fontSize < 10) return;
        const fg = parse(cs.color); if (!fg) return;
        let n = el, bg = null;
        while (n && n !== document.documentElement) { const c = parse(getComputedStyle(n).backgroundColor); if (c && c[3] > 0.6) { bg = c; break; } n = n.parentElement; }
        if (!bg) bg = [10, 11, 14, 1];
        const L1 = lum(fg[0], fg[1], fg[2]), L2 = lum(bg[0], bg[1], bg[2]);
        const ratio = (Math.max(L1, L2) + 0.05) / (Math.min(L1, L2) + 0.05);
        if (ratio < 4.5) out.contrast.push(`${el.tagName}.${String(el.className).split(' ')[0]} "${el.textContent.trim().slice(0, 18)}" ${ratio.toFixed(2)}:1 fs=${cs.fontSize}`);
      });
      // 4) 点击目标（移动端）
      if (isMobile) {
        document.querySelectorAll('a, button').forEach(el => {
          if (el.id && el.id.startsWith('aix-')) return; // 浏览器扩展注入的 DOM，非站点元素
          const r = el.getBoundingClientRect();
          if (r.width > 0 && r.height > 0 && (r.height < 34 || r.width < 34) && !el.closest('.ticker'))
            out.tap.push(`${el.tagName} "${(el.textContent || el.getAttribute('aria-label') || '').trim().slice(0, 14)}" ${Math.round(r.width)}x${Math.round(r.height)}`);
        });
      }
      // 5) 标题层级
      let last = 0;
      document.querySelectorAll('h1,h2,h3,h4').forEach(h => {
        const lv = +h.tagName[1];
        if (last && lv > last + 1) out.headings.push(`h${last} → ${h.tagName} 跳级 "${h.textContent.trim().slice(0, 14)}"`);
        last = lv;
      });
      // 6) 可访问名
      document.querySelectorAll('a, button').forEach(el => {
        const txt = (el.textContent || '').trim() || el.getAttribute('aria-label');
        if (!txt) out.a11y.push(`${el.tagName}.${String(el.className).split(' ')[0]} 无可访问名`);
      });
      // 7) 图片
      document.querySelectorAll('img').forEach(im => { if (!im.complete || im.naturalWidth === 0) out.imgs.push(im.getAttribute('src')); });
      // 8) 字体族一致性 + 过小文本
      document.querySelectorAll('main p, main span, main a, main li, main dd, main h1, main h2, main h3').forEach(el => {
        if (!el.textContent.trim()) return;
        const f = getComputedStyle(el).fontFamily.split(',')[0].replace(/["']/g, '');
        out.fonts[f] = (out.fonts[f] || 0) + 1;
        if (+getComputedStyle(el).fontSize < 9.5 && el.textContent.trim().length > 3) out.smalltext.push(`${el.tagName}.${String(el.className).split(' ')[0]} ${getComputedStyle(el).fontSize} "${el.textContent.trim().slice(0, 14)}"`);
      });
      return out;
    }, isMobile);
    R.misalign.slice(0, 5).forEach(x => F(tag === 'mobile' ? 'P2' : 'P1', tag + '/对齐', x));
    R.overlap.slice(0, 6).forEach(x => F('P0', tag + '/重叠', x));
    R.contrast.slice(0, 8).forEach(x => F('P1', tag + '/对比度', x));
    R.tap.slice(0, 8).forEach(x => F('P1', tag + '/点击目标', x));
    R.headings.slice(0, 4).forEach(x => F('P2', tag + '/标题层级', x));
    R.a11y.slice(0, 6).forEach(x => F('P1', tag + '/可访问名', x));
    R.imgs.slice(0, 4).forEach(x => F('P0', tag + '/图片加载', x));
    R.smalltext.slice(0, 6).forEach(x => F('P2', tag + '/过小文本', x));
    F('INFO', tag + '/字体族', JSON.stringify(R.fonts));
    await p.close();
    return R;
  }

  await audit({ width: 1600, height: 900 }, 'desktop');
  await audit({ width: 390, height: 844, isMobile: true }, 'mobile');

  await b.close();
  const sev = s => findings.filter(f => f.startsWith(`[${s}]`)).length;
  console.log(`=== 盲审报告 ${label} ===`);
  console.log(findings.join('\n') || '(clean)');
  console.log(`=== 统计: P0=${sev('P0')} P1=${sev('P1')} P2=${sev('P2')}`);
})().catch(e => { console.error('FATAL', e.message.slice(0, 300)); process.exit(1); });
